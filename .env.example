NODE_ENV=production
PORT=8787
SLEDGEWIRE_DATA_DIR=.sledgewire
SLEDGEWIRE_PRIVATE_KEY_FILE=/run/secrets/sledgewire-ed25519-private.pem
SLEDGEWIRE_PUBLIC_KEY_FILE=/run/secrets/sledgewire-ed25519-public.pem
SLEDGEWIRE_DB=.sledgewire/arena.db
SHAREDNET_SEAT=i_XXXXXXXXXX
SHAREDNET_ROOM_ID=rom_XXXXXXXXXX
SHAREDNET_PAYEE_ADDRESS=p_XXXXXXXXXX
# Set only after real SharedOS audit plumbing is configured and externally verified.
SLEDGEWIRE_SHAREDOS_REQUIRED=1
