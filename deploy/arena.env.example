# Public HTTPS origin served by your reverse proxy / TLS terminator.
PUBLIC_BASE_URL=https://sledgewire.example
SLEDGEWIRE_PORT=8787

# Organizer competition Arena Room and seller-owned payee.
SHAREDNET_ARENA_ROOM_ID=rom_REPLACE_ME
SHAREDNET_PAYEE_ADDRESS=pri_REPLACE_ME
SHAREDNET_BASE_URL=https://www.sharednet.ai

# Only set when a trusted reverse proxy rewrites Host before forwarding /mcp.
# Comma-separated authorities, with port when non-default.
SLEDGEWIRE_ALLOWED_HOSTS=

SLEDGEWIRE_ARENA_CONCURRENCY=4
